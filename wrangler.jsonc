{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swirl-girl",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "MENU_SNAPSHOT"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ADMIN_IMAGES",
      "bucket_name": "swirl-girl-admin-production"
    }
  ]
}
